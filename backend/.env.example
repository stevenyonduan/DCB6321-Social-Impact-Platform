# Spring does not auto-load .env. Export values or configure your IDE run environment.
SPRING_PROFILES_ACTIVE=local
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
# Opt-in database profile, using authorized DEVELOPMENT credentials only:
SIP_DB_URL=jdbc:postgresql://YOUR_DEV_HOST:5432/postgres?sslmode=verify-full
SIP_DB_USERNAME=YOUR_DEV_DATABASE_USER
SIP_DB_PASSWORD=YOUR_DEV_DATABASE_PASSWORD
# Reserved for future Auth integration; currently unused.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Render: prod is the Docker image default. Never combine with local/database.
# SPRING_PROFILES_ACTIVE=prod
# SPRING_DATASOURCE_URL=jdbc:postgresql://YOUR_POOLER_HOST:5432/postgres?sslmode=require
# SPRING_DATASOURCE_USERNAME=YOUR_DATABASE_USER
# SPRING_DATASOURCE_PASSWORD=YOUR_DATABASE_PASSWORD
# sslmode=require enforces encryption without a CA file; server identity is not verified.
# Render supplies PORT; outside Render it defaults to SERVER_PORT, then 8080.
# Optional exact origins, comma-separated, no wildcard or trailing slash:
# SIP_CORS_ALLOWED_ORIGINS=https://YOUR_APP.vercel.app
