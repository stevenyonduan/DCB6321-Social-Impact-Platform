# Spring does not auto-load .env. Export values in your shell or IDE run configuration.
SPRING_PROFILES_ACTIVE=local
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
# Only needed for opt-in database profile. Replace with DEVELOPMENT connection details.
SIP_DB_URL=jdbc:postgresql://YOUR_DEV_HOST:5432/postgres?sslmode=verify-full
SIP_DB_USERNAME=YOUR_DEV_DATABASE_USER
SIP_DB_PASSWORD=YOUR_DEV_DATABASE_PASSWORD
# Reserved for future auth implementation; currently unused.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
