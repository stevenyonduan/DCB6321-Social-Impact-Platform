# Public build-time values only. VITE_* values are visible to every browser.
VITE_API_BASE_URL=/api
# Public Auth settings for session adoption, persistence, refresh, and sign-out.
# Use the same development Supabase project as the Spring backend.
# Database passwords and service-role/secret keys must NEVER go here.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY
